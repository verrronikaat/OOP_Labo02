<UserControl x:Class="OOP_Labo01.Views.TriggersTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:OOP_Labo01.Services"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="780">
    <UserControl.Resources>
        <Style x:Key="AlertBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#4C8BF5"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#E8F1FF"/>
            <Setter Property="Padding" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="Background" Value="#FFE8E6"/>
                    <Setter Property="BorderBrush" Value="#E45858"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HoverCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FF"/>
                    <Setter Property="BorderBrush" Value="#2B579A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PulseOnClick" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1" To="1.06" Duration="0:0:0.1" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1" To="1.06" Duration="0:0:0.1" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Style="{StaticResource SectionTitle}"
                       Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TriggersSectionTitle, Mode=OneWay}"/>

            <Border Style="{StaticResource AlertBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TriggersDataDescription, Mode=OneWay}"/>
                    <Button Command="{Binding ToggleAlertCommand}" Style="{StaticResource PrimaryButton}"
                            Content="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TriggersToggleAlert, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HoverCard}" Margin="0,0,0,12">
                <TextBlock Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TriggersHoverDescription, Mode=OneWay}"/>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PulseOnClick}"
                        Command="{Binding IncrementCommand}"
                        Content="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TriggersAnimateButton, Mode=OneWay}"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0">
                    <Run Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TriggersClickPrefix, Mode=OneWay}"/>
                    <Run Text="{Binding ClickCount, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
