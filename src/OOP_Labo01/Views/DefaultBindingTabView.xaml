<UserControl x:Class="OOP_Labo01.Views.DefaultBindingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:OOP_Labo01.Services"
             xmlns:behaviors="clr-namespace:OOP_Labo01.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="780">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Style="{StaticResource SectionTitle}"
                       Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultSectionTitle, Mode=OneWay}"/>
            <TextBlock Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultSectionSubtitle, Mode=OneWay}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Margin="0,0,8,0"
                          Header="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultGroupDirectHeader, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultDirectDescription, Mode=OneWay}"/>
                        <Slider x:Name="DirectSlider"
                                Minimum="0" Maximum="100"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="35"
                                Margin="0,8,0,4"/>
                        <Label Content="{Binding Value, ElementName=DirectSlider}"
                               FontSize="18"
                               HorizontalAlignment="Left"/>

                        <TextBlock Margin="0,16,0,0"
                                   Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultTwoBoxesDescription, Mode=OneWay}"/>
                        <TextBox x:Name="LeftBox" Margin="0,6,0,4"
                                 behaviors:LocalizableField.TextResourceKey="DefaultLeftBoxText"
                                 behaviors:LocalizableField.HintResourceKey="DefaultLeftBoxHint"/>
                        <TextBox Text="{Binding Text, ElementName=LeftBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"
                                 ToolTip="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultLeftMirrorHint, Mode=OneWay}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1"
                          Header="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultGroupVmHeader, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultVmDescription, Mode=OneWay}"/>
                        <TextBox Text="{Binding DemoText}"
                                 ToolTip="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultDemoTextInitial, Mode=OneWay}"
                                 Margin="0,8,0,4"/>
                        <Label Content="{Binding DemoText}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=DefaultCaptionText, Mode=OneWay}"
                                   FontStyle="Italic" Opacity="0.85"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
