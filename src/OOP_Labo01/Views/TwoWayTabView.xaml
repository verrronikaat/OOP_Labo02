<UserControl x:Class="OOP_Labo01.Views.TwoWayTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:OOP_Labo01.Services"
             xmlns:behaviors="clr-namespace:OOP_Labo01.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="780">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Style="{StaticResource SectionTitle}"
                       Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TwoWaySectionTitle, Mode=OneWay}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Margin="0,0,8,0"
                          Header="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TwoWayGroupDirectHeader, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TwoWayDirectDescription, Mode=OneWay}"/>
                        <TextBox x:Name="SourceBox" Margin="0,8,0,4"
                                 behaviors:LocalizableField.TextResourceKey="TwoWaySourceText"
                                 behaviors:LocalizableField.HintResourceKey="TwoWaySourceHint"/>
                        <TextBox Text="{Binding Text, ElementName=SourceBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"/>
                        <Slider x:Name="DirectVolume" Minimum="0" Maximum="100" Value="55" Margin="0,12,0,4"/>
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TwoWaySliderCaptionPrefix, Mode=OneWay}"/>
                            <Run Text="{Binding Value, ElementName=DirectVolume, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1"
                          Header="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TwoWayGroupVmHeader, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TwoWayVmDescription, Mode=OneWay}"/>
                        <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TwoWayUserNameInitial, Mode=OneWay}"
                                 Margin="0,8,0,4"/>
                        <Label Content="{Binding UserName}" Margin="0,0,0,8"/>
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Margin="0,6,0,0">
                            <Run Text="{Binding Source={x:Static services:LocalizationBroker.Instance}, Path=TwoWayVolumeCaptionPrefix, Mode=OneWay}"/>
                            <Run Text="{Binding Volume, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
