<Window x:Class="OOP_Labo01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OOP_Labo01.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="620" Width="920"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <TabControl Style="{StaticResource LabTabControlStyle}">
            <!-- Вкладка 1: режим Default (как задано у DependencyProperty) -->
            <TabItem Header="1. По умолчанию (Default)">
                <views:DefaultBindingTabView/>
            </TabItem>
            <!-- Вкладка 2: TwoWay -->
            <TabItem Header="2. TwoWay">
                <views:TwoWayTabView/>
            </TabItem>
            <!-- Вкладка 3: OneTime -->
            <TabItem Header="3. OneTime">
                <views:OneTimeTabView/>
            </TabItem>
            <!-- Вкладка 4: OneWay -->
            <TabItem Header="4. OneWay">
                <views:OneWayTabView/>
            </TabItem>
            <!-- Вкладка 5: триггеры -->
            <TabItem Header="5. Триггеры">
                <views:TriggersTabView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
